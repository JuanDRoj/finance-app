# Variables del frontend (LOCAL). Copiar a `frontend/.env.local` (Next.js lo carga solo y git lo ignora):
#   cp .env.example .env.local
# Si falta una obligatoria o tiene mal formato, `npm run dev` y `npm run build` fallan y las listan todas.
# Todo lo de aqui es SOLO para desarrollo local: no son secretos ni valores de staging.

# --- Solo servidor (nunca llegan al navegador) ---
# URL del backend FastAPI, con http(s) y sin barra final. Local: `uv run fastapi dev` en el puerto 8000.
BACKEND_URL=http://localhost:8000

# --- Publicas (se incrustan en el bundle del navegador al hacer build: NUNCA poner secretos) ---
# Config web de Firebase. Con el emulador estos valores son de relleno, pero no pueden estar vacios.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
# Debe coincidir con FIREBASE_EMULATOR_PROJECT_ID (.env raiz) y FIREBASE_PROJECT_ID del backend:
# el backend valida los tokens del emulador contra este proyecto. El prefijo `demo-` evita tocar uno real.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-finance-local

# Solo local: host:puerto del emulador de Firebase Auth (docker compose up -d). Opcional.
# En staging/prod NO lo definas: el build falla si existe junto a VERCEL_ENV (Vercel).
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

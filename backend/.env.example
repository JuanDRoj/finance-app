# Variables del backend (local). Copiar a `backend/.env` si quieres cambiar algo.
# Solo se listan las que el backend usa hoy (valores de referencia de Firebase en el .env.example
# de la raiz).

# local | staging | prod
ENV=local
LOG_LEVEL=INFO

# Id del proyecto de GCP (staging/prod). Cloud Run no lo expone al contenedor: se configura en el
# servicio. Con el, los logs llevan `logging.googleapis.com/trace` y Cloud Logging los agrupa por
# request. Opcional: sin el solo se pierde esa correlacion (hay un aviso al arrancar).
# GOOGLE_CLOUD_PROJECT=

# --- Firebase Auth y sesion ---
# Solo local. Si esta definida con ENV=staging|prod, la app se niega a arrancar. Con ENV=local
# vale `localhost:9099` (el emulador de docker compose) aunque no la definas; vacia
# (`FIREBASE_AUTH_EMULATOR_HOST=`) la desactiva, para usar un proyecto real de Firebase.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Proyecto de Firebase para el que se emiten los ID tokens. Con ENV=local vale `demo-finance-local`
# (el del emulador: debe coincidir con FIREBASE_EMULATOR_PROJECT_ID del .env de la raiz y con
# NEXT_PUBLIC_FIREBASE_PROJECT_ID del frontend). Obligatoria en staging/prod.
# FIREBASE_PROJECT_ID=demo-finance-local

# Origenes del frontend que pueden crear o cerrar la sesion (POST/DELETE /auth/session), separados
# por comas: solo esquema, host y puerto, sin barra final ni ruta (`https://app.example.com`).
# Con ENV=local vale `http://localhost:3000`. Obligatoria en staging/prod.
# ALLOWED_ORIGINS=http://localhost:3000

# La cookie de sesion se llama `session` (sin Secure) con ENV=local y `__Host-session` (Secure) en
# cualquier otro entorno; no se configura.

# --- Base de datos ---
# Conexion directa (driver asyncpg obligatorio). Con ENV=local, si no la defines se usa esta
# misma (la BD de docker compose). En staging/prod es obligatoria, salvo que uses el Connector.
# DATABASE_URL=postgresql+asyncpg://finance:finance_dev@localhost:5432/finance

# Solo los tests: BD separada, su nombre debe terminar en `_test` (los tests de migraciones
# hacen `downgrade base`; con otro nombre la suite se niega a correr).
# TEST_DATABASE_URL=postgresql+asyncpg://finance:finance_dev@localhost:5432/finance_test

# Pool de conexiones por instancia: DB_POOL_SIZE + DB_MAX_OVERFLOW = maximo (2 + 3 = 5).
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=3
# DB_POOL_TIMEOUT=30

# Cloud SQL Python Connector (staging/prod). Si INSTANCE_CONNECTION_NAME existe, se usa el
# Connector y DATABASE_URL se ignora; entonces DB_USER, DB_PASSWORD y DB_NAME son obligatorias.
# DB_PASSWORD va en Secret Manager (nunca en el repo).
# INSTANCE_CONNECTION_NAME=proyecto:region:instancia
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# PUBLIC | PRIVATE | PSC
# DB_IP_TYPE=PUBLIC

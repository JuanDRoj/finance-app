# Variables del backend (local). Copiar a `backend/.env` si quieres cambiar algo.
# Solo se listan las que el backend usa hoy; las de BD y Firebase se anaden con sus tareas
# (valores de referencia en el .env.example de la raiz).

# local | staging | prod
ENV=local
LOG_LEVEL=INFO

# Solo local. Si esta definida con ENV=staging|prod, la app se niega a arrancar.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

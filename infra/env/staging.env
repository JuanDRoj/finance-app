# IDs y nombres NO secretos del entorno staging (KAN-9).
# Lo cargan con `source` los scripts de infra/scripts/ y lo lee el hook guard_cloud.
# Formato estricto KEY=valor: sin espacios alrededor del "=" y comentarios en línea propia.
# Nunca pongas aquí secretos, el ID de la cuenta de facturación ni números de proyecto.

# Proyecto (cuenta personal, sin organización). El ID no se puede reutilizar tras un borrado.
GCP_PROJECT_ID=kanza-stg
GCP_PROJECT_NAME=kanza-stg
FIREBASE_PROJECT_ID=kanza-stg

# Región única de GCP.
GCP_REGION=southamerica-east1

# Etiqueta env=<valor> en los recursos que admiten etiquetas.
ENV_LABEL=staging

# Artifact Registry (imágenes del backend).
AR_REPOSITORY=finance-stg

# Cuenta de servicio de runtime de Cloud Run.
RUN_SA_NAME=run-api-stg

# Cloud SQL (KAN-10). El nombre de conexión es <GCP_PROJECT_ID>:<GCP_REGION>:<SQL_INSTANCE>.
SQL_INSTANCE=finance-db-stg
SQL_DATABASE_VERSION=POSTGRES_16
SQL_EDITION=enterprise
SQL_TIER=db-f1-micro
SQL_STORAGE_TYPE=SSD
SQL_STORAGE_GB=10
SQL_SSL_MODE=TRUSTED_CLIENT_CERTIFICATE_REQUIRED
SQL_SERVER_CA_MODE=GOOGLE_MANAGED_INTERNAL_CA

# Base de datos y usuario de la app (los reutiliza Cloud Run en KAN-13) y el secreto con la contraseña.
DB_NAME=finance
DB_USER=finance_app
DB_PASSWORD_SECRET=finance-db-password-stg
DB_SECRET_TYPE=other-db-credentials

# Presupuesto mensual (solo alertas) en la cuenta de facturación, alcance: este proyecto.
BUDGET_DISPLAY_NAME=kanza-stg-budget
BUDGET_AMOUNT=20
BUDGET_CURRENCY=USD

# Workload Identity Federation GitHub -> GCP (KAN-12). Los IDs numericos de GitHub no son secretos:
# resisten renombres y transferencias del repo, y los usa la condicion del provider.
WIF_POOL=github-pool-stg
WIF_PROVIDER=github-oidc-stg
DEPLOYER_SA_NAME=github-deployer-stg
GITHUB_REPO=JuanDRoj/finance-app
GITHUB_REPO_ID=1403495096
GITHUB_OWNER_ID=76397954

# Cloud Run (KAN-13): servicio del backend y job de migraciones. La imagen es la misma para los dos.
# Min 0 instancias (costo minimo). Max 2 con el pool reducido de abajo: ver el presupuesto de
# conexiones en infra/RECURSOS.md. Cloud Run define PORT (8080) y el Dockerfile lo respeta.
CR_SERVICE=finance-api-stg
CR_JOB=finance-migrate-stg
IMAGE_NAME=finance-api
CR_PORT=8080
CR_MIN_INSTANCES=0
CR_MAX_INSTANCES=2
CR_CPU=1
CR_MEMORY=512Mi
# Job: una sola tarea y sin reintentos (una migracion rota debe fallar a la vista), 10 minutos como maximo.
CR_JOB_TIMEOUT_SECONDS=600
CR_JOB_MAX_RETRIES=0
# Pool del servicio (variables DB_POOL_SIZE y DB_MAX_OVERFLOW del backend): hasta 2 + 1 = 3 por instancia.
CR_DB_POOL_SIZE=2
CR_DB_MAX_OVERFLOW=1
# Origenes del frontend que pueden abrir sesion (ALLOWED_ORIGINS del backend). PROVISIONAL: este valor
# no resuelve, asi que nadie puede iniciar sesion hasta que KAN-14 cree el proyecto de Vercel y se
# reemplace por su URL (en el servicio de Cloud Run y aqui). El job tambien lo necesita aunque no lo
# use: alembic construye los mismos Settings que la API.
STAGING_ALLOWED_ORIGINS=https://staging.invalid

# Presupuesto de conexiones a Cloud SQL (criterio 3 de KAN-13; cuenta completa en infra/RECURSOS.md).
# SQL_INTERNAL_CONNECTIONS: sql_check.sh midio 2 conexiones internas de Cloud SQL el 16/10/2026; se cuentan 3
# como colchon conservador (ya no es una estimacion pendiente).
SQL_MAX_CONNECTIONS=25
SQL_RESERVED_CONNECTIONS=3
SQL_INTERNAL_CONNECTIONS=3
JOB_CONNECTIONS=1
ADMIN_CONNECTIONS=2
# Durante un despliegue pueden convivir dos revisiones, cada una con hasta CR_MAX_INSTANCES instancias.
CR_REVISIONS_IN_ROLLOUT=2

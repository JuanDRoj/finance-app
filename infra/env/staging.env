# IDs y nombres NO secretos del entorno staging (KAN-9).
# Lo cargan con `source` los scripts de infra/scripts/ y lo lee el hook guard_cloud.
# Formato estricto KEY=valor: sin espacios alrededor del "=" y comentarios en línea propia.
# Nunca pongas aquí secretos, el ID de la cuenta de facturación ni números de proyecto.

# Proyecto (cuenta personal, sin organización). El ID no se puede reutilizar tras un borrado.
GCP_PROJECT_ID=kanza-stg
GCP_PROJECT_NAME=kanza-stg
FIREBASE_PROJECT_ID=kanza-stg

# Región única de GCP.
GCP_REGION=southamerica-east1

# Etiqueta env=<valor> en los recursos que admiten etiquetas.
ENV_LABEL=staging

# Artifact Registry (imágenes del backend).
AR_REPOSITORY=finance-stg

# Cuenta de servicio de runtime de Cloud Run.
RUN_SA_NAME=run-api-stg

# Presupuesto mensual (solo alertas) en la cuenta de facturación, alcance: este proyecto.
BUDGET_DISPLAY_NAME=kanza-stg-budget
BUDGET_AMOUNT=20
BUDGET_CURRENCY=USD

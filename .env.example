# Variables del entorno LOCAL (Docker Compose). Copiar a `.env` si quieres cambiar algo;
# el compose funciona sin copiarlo porque cada variable tiene un valor por defecto.
# Todo lo de aqui es SOLO para desarrollo local: no son secretos ni valores de staging.

# --- PostgreSQL ---
POSTGRES_USER=finance
# Contrasena de desarrollo local. Nunca reutilizar en staging o prod.
POSTGRES_PASSWORD=finance_dev
POSTGRES_DB=finance
POSTGRES_PORT=5432

# --- Emulador de Firebase Auth ---
# El prefijo `demo-` evita que el emulador toque un proyecto real.
FIREBASE_EMULATOR_PROJECT_ID=demo-finance-local
FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_EMULATOR_UI_PORT=4000

# --- Valores que usara el backend (van en backend/.env, ver backend/.env.example) ---
# DATABASE_URL=postgresql+asyncpg://finance:finance_dev@localhost:5432/finance
# TEST_DATABASE_URL=postgresql+asyncpg://finance:finance_dev@localhost:5432/finance_test
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Debe coincidir con FIREBASE_EMULATOR_PROJECT_ID: el backend valida los tokens del emulador contra este proyecto.
# FIREBASE_PROJECT_ID=demo-finance-local
